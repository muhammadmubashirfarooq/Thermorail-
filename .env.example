# ==============================================================================
# ThermoRail - Environment Configuration Template
# Duplicate this file as .env and populate with your credentials.
# NEVER commit the actual .env file to version control.
# ==============================================================================

# Application Environment (development | staging | production)
ENVIRONMENT=development

# Backend Server Port
PORT=8000

# FortyGuard Hyperlocal Thermal Intelligence API
FORTYGUARD_API_KEY=your_fortyguard_api_key_here
FORTYGUARD_API_BASE_URL=https://api.fortyguard.com/v1

# Frontend Configuration (if running Next.js separately)
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_APP_ENV=development

# Geospatial & Risk Engine Parameters (Optional Overrides)
DEFAULT_CRT_THRESHOLD_CELSIUS=50.0
SPEED_RESTRICTION_BUFFER_CELSIUS=5.0
